{
  "installCommand": "npm ci",
  "buildCommand": "npm run build --workspace apps/web",
  "outputDirectory": "apps/web/dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "has": [{ "type": "host", "value": "mefit-fitness-planner.vercel.app" }],
      "destination": "https://mefit-api-sukumar.onrender.com/api/:path*"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
