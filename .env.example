# Local development only. Replace every value before deployment.
NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:5173
API_PUBLIC_ORIGIN=http://localhost:4000
POSTGRES_PASSWORD=CHANGE_ME_LOCAL_ONLY
DATABASE_URL=postgresql://mefit:CHANGE_ME_LOCAL_ONLY@localhost:5432/mefit?schema=public
OIDC_ISSUER=http://localhost:8080/realms/mefit
OIDC_AUDIENCE=mefit-api
OIDC_CLIENT_ID=mefit-web
# Migration target: set AUTH_PROVIDER=supabase only after configuring both API and web env values.
AUTH_PROVIDER=keycloak
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
SUPABASE_JWT_ISSUER=https://<project-ref>.supabase.co/auth/v1
SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_AUDIENCE=authenticated
KEYCLOAK_ADMIN=local-admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME_LOCAL_ONLY
MEFIT_ADMIN_EMAIL=
# Render production Keycloak settings (set these manually on the Render service).
# For Neon, use the direct host (not the hostname containing "-pooler"); Keycloak
# maintains its own connection pool. sslmode=require encrypts the database connection;
# connectTimeout=30 gives a suspended Neon database time to wake during connection.
KC_DB=postgres
KC_DB_URL=jdbc:postgresql://<direct-neon-host>/<database>?sslmode=require&connectTimeout=30&tcpKeepAlive=true
KC_DB_USERNAME=CHANGE_ME
KC_DB_PASSWORD=CHANGE_ME
JAVA_OPTS_KC_HEAP="-Xms64m -Xmx300m -XX:MaxMetaspaceSize=128m"
VITE_API_URL=http://localhost:4000/api
VITE_OIDC_AUTHORITY=http://localhost:8080/realms/mefit
VITE_OIDC_CLIENT_ID=mefit-web
VITE_OIDC_REDIRECT_URI=http://localhost:5173/auth/callback
VITE_AUTH_PROVIDER=keycloak
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
BACKUP_DIRECTORY=./backups
# Required by scripts/backup-postgres.sh; use a long randomly generated secret.
BACKUP_ENCRYPTION_KEY=
